# ── Angel One SmartAPI ────────────────────────────────────────────────────────
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_password
ANGEL_TOTP_SECRET=your_totp_secret

# ── LLM Configuration (OpenAI-compatible: OpenRouter, DeepSeek, Groq, Ollama, etc.)
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openrouter/free

# Prioritized Cascading Model Chain (comma-separated, tried in order)
LLM_MODELS=openrouter/free,nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,bytedance-seed/seed-1.6-flash

# ── Supabase Cloud Database ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
